    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "libreoffice-convert": "^1.8.2",
    "mammoth": "^1.12.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
